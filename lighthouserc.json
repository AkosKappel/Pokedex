{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec vite preview --port 4175 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4175/",
        "http://localhost:4175/pokemon/",
        "http://localhost:4175/pokemon/25/",
        "http://localhost:4175/compare/?ids=1,4,7",
        "http://localhost:4175/moves/",
        "http://localhost:4175/moves/85/",
        "http://localhost:4175/items/",
        "http://localhost:4175/team/?ids=6,9,3",
        "http://localhost:4175/about/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
